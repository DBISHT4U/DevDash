# DevDash Demo — VHS Recording
# Run: vhs devdash-demo.tape

Output demo.gif
Set FontSize 13
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set Padding 15
Set TypingSpeed 35ms
Set CursorBlink false

Type "# 💻 DevDash — Beautiful terminal dashboard"
Enter
Sleep 1s

Type "devdash"
Enter
Sleep 5s

# Switch to Git tab
Type ""
Sleep 3s

# Switch back to System tab
Type ""
Sleep 3s

# Refresh
Type "r"
Sleep 3s

# Quit
Type "q"
Sleep 1s

Type "# 🦀 System stats + Git info — one gorgeous TUI"
Enter
Sleep 2s
